# Set a long, unique value in production. Do not commit the real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated frontend origins; localhost defaults remain enabled for development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set this to use PostgreSQL for authentication. Without it, local SQLite remains the default.
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
