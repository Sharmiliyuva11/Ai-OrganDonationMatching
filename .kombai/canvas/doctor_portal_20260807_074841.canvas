      "html": "<div class=\"flex min-h-screen bg-[#f7fafb] font-sans selection:bg-[#0F766E]/20\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"w-[228px] bg-white border-r border-[#e5e7eb] flex flex-col fixed inset-y-0 left-0 z-50\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"p-6 pb-2\" data-kid=\"1-1-1\" data-name=\"brand logo and title container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding logo block\">\n                <div class=\"w-10 h-10 bg-[#0F766E] rounded-xl flex items-center justify-center text-white shadow-sm shadow-[#0F766E]/20\" data-kid=\"1-1-1-1-1\" data-name=\"heart pulse icon container\">\n                    <i class=\"lucide-heart-pulse w-6 h-6\" data-kid=\"1-1-1-1-1-1\" data-name=\"heart pulse icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand identity text block\">\n                    <h1 class=\"font-extrabold text-slate-800 leading-tight tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title text\">\n                        OrganLink AI\n                    </h1>\n                    <p class=\"text-[10px] text-[#0F766E] font-bold uppercase tracking-widest\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Doctor Portal\n                    </p>\n                </div>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-4 py-4 space-y-1\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <p class=\"px-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4\" data-kid=\"1-1-2-1\" data-name=\"clinical menu header\">\n                Clinical\n            </p>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors\" data-kid=\"1-1-2-2\" data-name=\"dashboard link\" href=\"#\">\n                <i class=\"lucide-layout-grid w-4 h-4\" data-kid=\"1-1-2-2-1\" data-name=\"dashboard grid icon\">\n                </i>\n                Dashboard\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors\" data-kid=\"1-1-2-3\" data-name=\"ai match prediction link\" href=\"#\">\n                <i class=\"lucide-microscope w-4 h-4\" data-kid=\"1-1-2-3-1\" data-name=\"microscope icon\">\n                </i>\n                AI Match Prediction\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors\" data-kid=\"1-1-2-4\" data-name=\"find matching donor link\" href=\"#\">\n                <i class=\"lucide-search w-4 h-4\" data-kid=\"1-1-2-4-1\" data-name=\"search icon\">\n                </i>\n                Find Matching Donor\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors\" data-kid=\"1-1-2-5\" data-name=\"patient cases link\" href=\"#\">\n                <i class=\"lucide-users w-4 h-4\" data-kid=\"1-1-2-5-1\" data-name=\"users group icon\">\n                </i>\n                Patient Cases\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors\" data-kid=\"1-1-2-6\" data-name=\"recommended matches link\" href=\"#\">\n                <i class=\"lucide-sparkles w-4 h-4\" data-kid=\"1-1-2-6-1\" data-name=\"sparkles icon\">\n                </i>\n                Recommended Matches\n            </a>\n            <a class=\"flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-[#0F766E] bg-[#dff7f2] rounded-lg\" data-kid=\"1-1-2-7\" data-name=\"prediction history link\" href=\"#\">\n                <i class=\"