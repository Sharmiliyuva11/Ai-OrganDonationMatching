border-gray-100 shadow-sm p-6\" data-kid=\"1-3-2-3-2-1\" data-name=\"schedule section\">\n                        <h5 class=\"text-sm font-bold text-gray-900 mb-6\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"schedule title\">\n                            Today's Schedule\n                        </h5>\n                        <div class=\"space-y-6\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"schedule item list\">\n                            <div class=\"flex gap-4\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"schedule item 1\">\n                                <div class=\"text-[11px] font-bold text-[#0F766E] w-10 shrink-0\" data-kid=\"1-3-2-3-2-1-2-1-1\" data-name=\"schedule time\">\n                                    09:00\n                                </div>\n                                <div data-kid=\"1-3-2-3-2-1-2-1-2\" data-name=\"schedule activity info\">\n                                    <p class=\"text-xs font-semibold text-gray-800\" data-kid=\"1-3-2-3-2-1-2-1-2-1\" data-name=\"title\">\n                                        Pre-transplant review — PT-10241\n                                    </p>\n                                    <p class=\"text-[10px] text-gray-400 mt-1\" data-kid=\"1-3-2-3-2-1-2-1-2-2\" data-name=\"location\">\n                                        OPD 3\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-4\" data-kid=\"1-3-2-3-2-1-2-2\" data-name=\"schedule item 2\">\n                                <div class=\"text-[11px] font-bold text-[#0F766E] w-10 shrink-0\" data-kid=\"1-3-2-3-2-1-2-2-1\" data-name=\"schedule time\">\n                                    11:30\n                                </div>\n                                <div data-kid=\"1-3-2-3-2-1-2-2-2\" data-name=\"schedule activity info\">\n                                    <p class=\"text-xs font-semibold text-gray-800\" data-kid=\"1-3-2-