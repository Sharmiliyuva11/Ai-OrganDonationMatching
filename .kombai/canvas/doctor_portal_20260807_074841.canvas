                           </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3\" data-kid=\"1-3-2-3-2-2-2-2\" data-name=\"notification 2\">\n                                <div class=\"w-2 h-2 rounded-full bg-red-500 mt-1.5 shrink-0\" data-kid=\"1-3-2-3-2-2-2-2-1\" data-name=\"unread status indicator\">\n                                </div>\n                                <div data-kid=\"1-3-2-3-2-2-2-2-2\" data-name=\"notification content\">\n                                    <p class=\"text-[11px] font-medium text-gray-800\" data-kid=\"1-3-2-3-2-2-2-2-2-1\" data-name=\"notification title\">\n                                        Emergency case registered — PT-10252\n                                    </p>\n                                    <p class=\"text-[10px] text-gray-400 mt-0.5\" data-kid=\"1-3-2-3-2-2-2-2-2-2\" data-name=\"notification timestamp\">\n                                        48 min ago\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3\" data-kid=\"1-3-2-3-2-2-2-3\" data-name=\"notification 3\">\n                                <div class=\"w-2 h-2 rounded-full bg-blue-500 mt-1.5 shrink-0\" data-kid=\"1-3-2-3-2-2-2-3-1\" data-name=\"unread status indicator\">\n                                </div>\n                                <div data-kid=\"1-3-2-3-2-2-2-3-2\" data-name=\"notification content\">\n                                    <p class=\"text-[11px] font-medium text-gray-800\" data-kid=\"1-3-2-3-2-2-2-3-2-1\" data-name=\"notification title\">\n                                        Report RP-4409 approved by admin\n                                    </p>\n                                    <p class=\"text-[10px] text-gray-400 mt-0.5\" data-kid=\"1-3-2-3-2-2-2-3-2-2\" data-name=\"notification timestamp\">\n                                        2 h ago\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3\" data-kid=\"1-3-2-3-2-2-2-4\" data-name=\"notification 4\">\n                                <div class=\"w-2 h-2 rounded-full bg-orange-400 mt-1.5 shrink-0\" data-kid=\"1-3-2-3-2-2-2-4-1\" data-name=\"unread status indicator\">\n                                </div>\n                                <div data-kid=\"1-3-2-3-2-2-2-4-2\" data-name=\"notification content\">\n                                    <p class=\"text-[11px] font-medium text-gray-800\" data-kid=\"1-3-2-3-2-2-2-4-2-1\" data-name=\"notification title\">\n                                        HLA lab results pending for PT-10238\n                                    </p>\n                                    <p class=\"text-[10px] text-gray-400 mt-0.5\" data-kid=\"1-3-2-3-2-2-2-4-2-2\" data-name=\"notification timestamp\">\n                                        5 h ago\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <!-- Upcoming Surgeries -->\n                    <section class=\"bg-white rounded-2xl border border-gray-100 shadow-sm p-6\" data-kid=\"1-3-2-3-2-3\" data-name=\"surgeries section\">\n                        <h5 class=\"text-sm font-bold text-gray-900 mb-6\" data-kid=\"1-3-2-3-2-3-1\" data-name=\"surgeries title\">\n                            Upcoming Surgeries\n                        </h5>\n                        <div class=\"space-y-4\" data-kid=\"1-3-2-3-2-3-2\" data-name=\"surgeries list\">\n                            <div class=\"p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition-colors\" data-kid=\"1-3-2-3-2-3-2-1\" data-name=\"surgery item 1\">\n                                <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-3-2-3-2-3-2-1-1\" data-name=\"surgery row header\">\n                                    <h6 class=\"text-[11px] font-bold text-gray-900\" data-kid=\"1-3-2-3-2-3-2-1-1-1\" data-name=\"patient name\">\n                                        Hamza Iqbal\n                                    </h6>\n                                    <span class=\"px-2 py-0.5 bg-teal-50 text-[#0F766E] text-[9px] font-bold rounded border border-teal-100 flex items-center gap-1\" data-kid=\"1-3-2-3-2-3-2-1-1-2\" data-name=\"ot status tag\">\n                                        <i class=\"w-2.5 h-2.5 fill-current\" data-kid=\"1-3-2-3-2-3-2-1-1-2-1\" data-lucide=\"zap\" data-name=\"zap icon\">\n                                        </i>\n                                        OT-2\n                                    </span>\n                                </div>\n                                <p class=\"text-[10px] text-gray-400 uppercase tracking-tight\" data-kid=\"1-3-2-3-2-3-2-1-2\" data-name=\"surgery details\">\n                                    Kidney · Aug 08, 08:00\n                                </p>\n                            </div>\n                            <div class=\"p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition-colors\" data-kid=\"1-3-2-3-2-3-2-2\" data-name=\"surgery item 2\">\n                                <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-3-2-3-2-3-2-2-1\" data-name=\"surgery row header\">\n                                    <h6 class=\"text-[11px] font-bold text-gray-900\" data-kid=\"1-3-2-3-2-3-2-2-1-1\" data-name=\"patient name\">\n                                        Daniel Okoye\n                                    </h6>\n                                    <span class=\"px-2 py-0.5 bg-teal-50 text-[#0F766E] text-[9px] font-bold rounded border border-teal-100 flex items-center gap-1\" data-kid=\"1-3-2-3-2-3-2-2-1-2\" data-name=\"ot status tag\">\n                                        <i class=\"w-2.5 h-2.5 fill-current\" data-kid=\"1-3-2-3-2-3-2-2-1-2-1\" data-lucide=\"zap\" data-name=\"zap icon\">\n                                        </i>\n                                        OT-1\n                                    </span>\n                                </div>\n                                <p class=\"text-[10px] text-gray-400 uppercase tracking-tight\" data-kid=\"1-3-2-3-2-3-2-2-2\" data-name=\"surgery details\">\n                                    Heart · Aug 11, 06:30\n                                </p>\n                            </div>\n                            <div class=\"p-3 border border-gray-100 rounded-xl hover:bg-gray-50 transition-colors\" data-kid=\"1-3-2-3-2-3-2-3\" data-name=\"surgery item 3\">\n                                <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-3-2-3-2-3-2-3-1\" data-name=\"surgery row header\">\n                                    <h6 class=\"text-[11px] font-bold text-gray-900\" data-kid=\"1-3-2-3-2-3-2-3-1-1\" data-name=\"patient name\">\n                                        Marco Bellini\n                                    </h6>\n                                    <span class=\"px-2 py-0.5 bg-teal-50 text-[#0F766E] text-[9px] font-bold rounded border border-teal-100 flex items-center gap-1\" data-kid=\"1-3-2-3-2-3-2-3-1-2\" data-name=\"ot status tag\">\n                                        <i class=\"w-2.5 h-2.5 fill-current\" data-kid=\"1-3-2-3-2-3-2-3-1-2-1\" data-lucide=\"zap\" data-name=\"zap icon\">\n                                        </i>\n                                        OT-4\n                                    </span>\n                                </div>\n                                <p class=\"text-[10px] text-gray-400 uppercase tracking-tight\" data-kid=\"1-3-2-3-2-3-2-3-2\" data-name=\"surgery details\">\n                                    Lung · Aug 14, 09:15\n                                </p>\n                            </div>\n                        </div>\n                    </section>\n                    <!-- Quick Actions -->\n                    <section class=\"bg-white rounded-2xl border border-gray-100 shadow-sm p-6\" data-kid=\"1-3-2-3-2-4\" data-name=\"quick actions section\">\n                        <h5 class=\"text-sm font-bold text-gray-900 mb-6\" data-kid=\"1-3-2-3-2-4-1\" data-name=\"quick actions title\">\n                            Quick Actions\n                        </h5>\n                        <div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-3-2-3-2-4-2\" data-name=\"quick actions grid\">\n                            <button class=\"flex flex-col items-start p-4 bg-white border border-gray-100 rounded-xl hover:border-[#dff7f2] hover:bg-teal-50/20 transition-all text-left group w-full\" data-kid=\"1-3-2-3-2-4-2-1\" data-name=\"new prediction action\">\n                                <i class=\"w-4 h-4 text-[#0F766E] mb-3\" data-kid=\"1-3-2-3-2-4-2-1-1\" data-lucide=\"zap\" data-name=\"zap icon\">\n                                </i>\n                                <div class=\"flex items-center justify-between w-full\" data-kid=\"1-3-2-3-2-4-2-1-2\" data-name=\"action title block\">\n                                    <span class=\"text-[10px] font-bold text-gray-900 leading-tight\" data-kid=\"1-3-2-3-2-4-2-1-2-1\" data-name=\"action name\">\n                                        New Prediction\n                                    </span>\n                                    <i class=\"w-3 h-3 text-gray-300 group-hover:text-[#0F766E] transition-colors shrink-0\" data-kid=\"1-3-2-3-2-4-2-1-2-2\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\">\n                                    </i>\n                                </div>\n                            </button>\n                            <button class=\"flex flex-col items-start p-4 bg-white border border-gray-100 rounded-xl hover:border-[#dff7f2] hover:bg-teal-50/20 transition-all text-left group w-full\" data-kid=\"1-3-2-3-2-4-2-2\" data-name=\"find donor action\">\n                                <i class=\"w-4 h-4 text-[#0F766E] mb-3\" data-kid=\"1-3-2-3-2-4-2-2-1\" data-lucide=\"user-search\" data-name=\"user search icon\">\n                                </i>\n                                <div class=\"flex items-center justify-between w-full\" data-kid=\"1-3-2-3-2-4-2-2-2\" data-name=\"action title block\">\n                                    <span class=\"text-[10px] font-bold text-gray-900 leading-tight\" data-kid=\"1-3-2-3-2-4-2-2-2-1\" data-name=\"action name\">\n                                        Find Donor\n                                    </span>\n                                    <i class=\"w-3 h-3 text-gray-300 group-hover:text-[#0F766E] transition-colors shrink-0\" data-kid=\"1-3-2-3-2-4-2-2-2-2\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\">\n                                    </i>\n                                </div>\n                            </button>\n                            <button class=\"flex flex-col items-start p-4 bg-white border border-gray-100 rounded-xl hover:border-[#dff7f2] hover:bg-teal-50/20 transition-all text-left group w-full\" data-kid=\"1-3-2-3-2-4-2-3\" data-name=\"generate report action\">\n                                <i class=\"w-4 h-4 text-[#0F766E] mb-3\" data-kid=\"1-3-2-3-2-4-2-3-1\" data-lucide=\"file-text\" data-name=\"file text icon\">\n                                </i>\n                                <div class=\"flex items-center justify-between w-full\" data-kid=\"1-3-2-3-2-4-2-3-2\" data-name=\"action title block\">\n                                    <span class=\"text-[10px] font-bold text-gray-900 leading-tight\" data-kid=\"1-3-2-3-2-4-2-3-2-1\" data-name=\"action name\">\n                                        Generate Report\n                                    </span>\n                                    <i class=\"w-3 h-3 text-gray-300 group-hover:text-[#0F766E] transition-colors shrink-0\" data-kid=\"1-3-2-3-2-4-2-3-2-2\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\">\n                                    </i>\n                                </div>\n                            </button>\n                            <button class=\"flex flex-col items-start p-4 bg-white border border-gray-100 rounded-xl hover:border-[#dff7f2] hover:bg-teal-50/20 transition-all text-left group w-full\" data-kid=\"1-3-2-3-2-4-2-4\" data-name=\"schedule surgery action\">\n                                <i class=\"w-4 h-4 text-[#0F766E] mb-3\" data-kid=\"1-3-2-3-2-4-2-4-1\" data-lucide=\"calendar\" data-name=\"calendar icon\">\n                                </i>\n                                <div class=\"flex items-center justify-between w-full\" data-kid=\"1-3-2-3-2-4-2-4-2\" data-name=\"action title block\">\n                                    <span class=\"text-[10px] font-bold text-gray-900 leading-tight\" data-kid=\"1-3-2-3-2-4-2-4-2-1\" data-name=\"action name\">\n                                        Schedule Surgery\n                                    </span>\n                                    <i class=\"w-3 h-3 text-gray-300 group-hover:text-[#0F766E] transition-colors shrink-0\" data-kid=\"1-3-2-3-2-4-2-4-2-2\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\">\n                                    </i>\n                                </div>\n                            </button>\n                        </div>\n                    </section>\n                </aside>\n            </div>\n        </div>\n    </main>\n</div>\n<!-- Scripts Area -->\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    // Initialize Lucide icons\n    lucide.createIcons();\n\n    // Mobile Menu Toggle logic\n    const sidebar = document.getElementById('sidebar');\n    const menuToggle = document.getElementById('menu-toggle');\n    const backdrop = document.getElementById('mobile-backdrop');\n\n    if (menuToggle && sidebar && backdrop) {\n        menuToggle.addEventListener('click', () => {\n            sidebar.classList.toggle('-translate-x-full');\n            backdrop.classList.toggle('hidden');\n        });\n\n        backdrop.addEventListener('click', () => {\n            sidebar.classList.add('-translate-x-full');\n            backdrop.classList.add('hidden');\n        });\n    }\n\n    // GSAP Entrance Animation\n    // Target the specific items instead of using '>'\n    gsap.from(\".dashboard-animate-item\", {\n        opacity: 0,\n        y: 15,\n        duration: 0.5,\n        stagger: 0.1,\n        ease: \"power1.out\",\n        clearProps: \"all\"\n    });\n</script>\n",
