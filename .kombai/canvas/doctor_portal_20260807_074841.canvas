Confidence 88%\n                            </div>\n                            <div class=\"flex items-center gap-1.5 text-emerald-600 font-bold text-[11px]\" data-kid=\"1-2-2-4-2-3-2-2\" data-name=\"verification status container\">\n                                <i class=\"w-3.5 h-3.5\" data-kid=\"1-2-2-4-2-3-2-2-1\" data-lucide=\"check-circle-2\" data-name=\"verified check icon\">\n                                </i>\n                                Verified\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-2.5 mt-6\" data-kid=\"1-2-2-4-2-4\" data-name=\"action button container\">\n                        <button class=\"w-full py-2.5 bg-[#0F766E] text-white rounded-lg font-bold hover:bg-[#0D635D] transition-all text-[13px] shadow-sm shadow-[#0F766E]/10 cursor-pointer\" data-kid=\"1-2-2-4-2-4-1\" data-name=\"contact hospital primary button\">\n                            Contact Hospital\n                        </button>\n                        <button class=\"w-full py-2.5 border border-slate-200 rounded-lg text-slate-500 font-bold hover:bg-slate-50 transition-all text-[13px] cursor-pointer\" data-kid=\"1-2-2-4-2-4-2\" data-name=\"view details secondary button\">\n                            View Details\n                        </button>\n                    </div>\n                </div>\n                <!-- Card 3 -->\n                <div class=\"bg-white rounded-[14px] border border-slate-200 card-shadow hover:border-[#0F766E]/30 hover:shadow-md transition-all p-6 group flex flex-col\" data-kid=\"1-2-2-4-3\" data-name=\"third donor result card\">\n                    <div class=\"flex justify-between items-start mb-6\" data-kid=\"1-2-2-4-3-1\" data-name=\"donor card header\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-2-4-3-1-1\" data-name=\"donor avatar and info\">\n                            <div class=\"w-11 h-11 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600 font-bold text-[18px] border border-amber-100/50\" data-kid=\"1-2-2-4-3-1-1-1\" data-name=\"donor identifier box\">\n                                172\n                            </div>\n                            <div data-kid=\"1-2-2-4-3-1-1-2\" data-name=\"donor identification text\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-4-3-1-1-2-1\" data-name=\"donor identification header\">\n                                    <h4 class=\"font-bold text-slate-800 text-[15px]\" data-kid=\"1-2-2-4-3-1-1-2-1-1\" data-name=\"donor id text\">\n                                        DN-10255\n                                    </h4>\n                                    <span class=\"text-slate-400 font-medium text-[12px]\" data-kid=\"1-2-2-4-3-1-1-2-1-2\" data-name=\"donor demographic text\">\n                                        29 yr, F\n                                    </span>\n                                </div>\n                                <p class=\"text-slate-500 font-medium text-[13px]\" data-kid=\"1-2-2-4-3-1-1-2-2\" data-name=\"donor name text\">\n                                    Daniel Okoye\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"bg-amber-50 text-amber-700 px-3 py-1 rounded-full text-[10px] font-bold flex items-center gap-1 border border-amber-100 whitespace-nowrap uppercase tracking-wider\" data-kid=\"1-2-2-4-3-1-2\" data-name=\"donor suitability status\">\n                            <i class=\"w-3.5 h-3.5\" data-kid=\"1-2-2-4-3-1-2-1\" data-lucide=\"clock\" data-name=\"suitability clock icon\">\n                            </i>\n                            Pending\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-y-5 gap-x-4 mb-6\" data-kid=\"1-2-2-4-3-2\" data-name=\"donor details grid\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-4-3-2-1\" data-name=\"blood group detail\">\n                            <i class=\"w-4 h-4 text-slate-300\" data-kid=\"1-2-2-4-3-2-1-1\" data-lucide=\"droplet\" data-name=\"blood group icon\">\n                            </i>\n                            <div data-kid=\"1-2-2-4-3-2-1-2\" data-name=\"blood group label/value container\">\n                                <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-4-3-2-1-2-1\" data-name=\"blood group label\">\n                                    Blood Group\n                                </p>\n                                <p class=\"font-bold text-slate-700 text-[13px]\" data-kid=\"1-2-2-4-3-2-1-2-2\" data-name=\"blood group value\">\n                                    A-\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-4-3-2-2\" data-name=\"organ detail\">\n                            <i class=\"w-4 h-4 text-slate-300\" data-kid=\"1-2-2-4-3-2-2-1\" data-lucide=\"activity\" data-name=\"organ icon\">\n                            </i>\n                            <div data-kid=\"1-2-2-4-3-2-2-2\" data-name=\"organ label/value container\">\n                                <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-4-3-2-2-2-1\" data-name=\"organ label\">\n                                    Organ\n                                </p>\n                                <p class=\"font-bold text-slate-700 text-[13px]\" data-kid=\"1-2-2-4-3-2-2-2-2\" data-name=\"organ value\">\n                                    Liver\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-4-3-2-3\" data-name=\"hospital detail\">\n                            <i class=\"w-4 h-4 text-slate-300\" data-kid=\"1-2-2-4-3-2-3-1\" data-lucide=\"hospital\" data-name=\"hospital icon\">\n                            </i>\n                            <div data-kid=\"1-2-2-4-3-2-3-2\" data-name=\"hospital label/value container\">\n                                <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-4-3-2-3-2-1\" data-name=\"hospital label\">\n                                    Hospital\n                                </p>\n                                <p class=\"font-bold text-slate-700 text-[13px] truncate w-[90px]\" data-kid=\"1-2-2-4-3-2-3-2-2\" data-name=\"hospital value\">\n                                    Grand Health\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-4-3-2-4\" data-name=\"city detail\">\n                            <i class=\"w-4 h-4 text-slate-300\" data-kid=\"1-2-2-4-3-2-4-1\" data-lucide=\"map-pin\" data-name=\"location icon\">\n                            </i>\n                            <div data-kid=\"1-2-2-4-3-2-4-2\" data-name=\"city label/value container\">\n                                <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1\" data-kid=\"1-2-2-4-3-2-4-2-1\" data-name=\"city label\">\n                                    City\n                                </p>\n                                <p class=\"font-bold text-slate-700 text-[13px]\" data-kid=\"1-2-2-4-3-2-4-2-2\" data-name=\"city value\">\n                                    Islamabad\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"space-y-4 pt-5 border-t border-slate-100 mt-auto\" data-kid=\"1-2-2-4-3-3\" data-name=\"compatibility and status footer\">\n                        <div data-kid=\"1-2-2-4-3-3-1\" data-name=\"compatibility meter container\">\n                            <div class=\"flex justify-between items-center mb-2\" data-kid=\"1-2-2-4-3-3-1-1\" data-name=\"compatibility header container\">\n                                <span class=\"text-[13px] font-bold text-slate-500\" data-kid=\"1-2-2-4-3-3-1-1-1\" data-name=\"compatibility label\">\n                                    Compatibility\n                                </span>\n                                <span class=\"text-[13px] font-bold text-amber-600\" data-kid=\"1-2-2-4-3-3-1-1-2\" data-name=\"compatibility percentage\">\n                                    84%\n                                </span>\n                            </div>\n                            <div class=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\" data-kid=\"1-2-2-4-3-3-1-2\" data-name=\"compatibility bar track\">\n                                <div class=\"h-full bg-amber-500 rounded-full\" data-kid=\"1-2-2-4-3-3-1-2-1\" data-name=\"compatibility bar progress\" style=\"width: 84%\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-4-3-3-2\" data-name=\"ai status container\">\n                            <div class=\"bg-amber-50 text-amber-700 px-3 py-1 rounded-full text-[11px] font-bold border border-amber-100/50\" data-kid=\"1-2-2-4-3-3-2-1\" data-name=\"ai confidence badge\">\n                                AI Confidence 80%\n                            </div>\n                            <div class=\"flex items-center gap-1.5 text-slate-400 font-bold text-[11px]\" data-kid=\"1-2-2-4-3-3-2-2\" data-name=\"review status container\">\n                                <i class=\"w-3.5 h-3.5\" data-kid=\"1-2-2-4-3-3-2-2-1\" data-lucide=\"help-circle\" data-name=\"review help icon\">\n                                </i>\n                                Reviewing\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-2.5 mt-6\" data-kid=\"1-2-2-4-3-4\" data-name=\"action button container\">\n                        <button class=\"w-full py-2.5 bg-[#0F766E] text-white rounded-lg font-bold hover:bg-[#0D635D] transition-all text-[13px] shadow-sm shadow-[#0F766E]/10 cursor-pointer\" data-kid=\"1-2-2-4-3-4-1\" data-name=\"contact hospital primary button\">\n                            Contact Hospital\n                        </button>\n                        <button class=\"w-full py-2.5 border border-slate-200 rounded-lg text-slate-500 font-bold hover:bg-slate-50 transition-all text-[13px] cursor-pointer\" data-kid=\"1-2-2-4-3-4-2\" data-name=\"view details secondary button\">\n                            View Details\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
