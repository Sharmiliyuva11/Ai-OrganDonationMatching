      "html": "<div class=\"flex min-h-screen bg-[#f7fafb] font-['Inter'] text-slate-800 antialiased selection:bg-teal-100 selection:text-teal-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"w-[228px] fixed inset-y-0 left-0 bg-white border-r border-slate-200 z-50 hidden md:flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation\">\n        <div class=\"p-6 flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"sidebar header container\">\n            <div class=\"w-8 h-8 bg-[#0F766E] rounded-lg flex items-center justify-center text-white\" data-kid=\"1-1-1-1\" data-name=\"logo icon container\">\n                <i class=\"ti ti-heart-handshake text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"handshake logo icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"platform identity container\">\n                <h1 class=\"text-sm font-bold text-slate-900 leading-tight\" data-kid=\"1-1-1-2-1\" data-name=\"platform name heading\">\n                    OrganLink AI\n                </h1>\n                <p class=\"text-[10px] text-slate-400 font-medium uppercase tracking-wider\" data-kid=\"1-1-1-2-2\" data-name=\"portal role subtitle\">\n                    Doctor Portal\n                </p>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-4 py-4 space-y-1\" data-kid=\"1-1-2\" data-name=\"navigation menu links\">\n            <p class=\"px-2 mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"1-1-2-1\" data-name=\"navigation group label\">\n                Clinical\n            </p>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-slate-500 hover:text-[#0F766E] hover:bg-teal-50 rounded-xl transition-all group\" data-kid=\"1-1-2-2\" data-name=\"dashboard navigation link\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-1-2-2-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"dashboard label\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-slate-500 hover:text-[#0F766E] hover:bg-teal-50 rounded-xl transition-all group\" data-kid=\"1-1-2-3\" data-name=\"AI match prediction link\" href=\"#\">\n                <i class=\"ti ti-stethoscope text-lg\" data-kid=\"1-1-2-3-1\" data-name=\"AI match prediction icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"AI match prediction label\">\n                    AI Match Prediction\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-slate-500 hover:text-[#0F766E] hover:bg-teal-50 rounded-xl transition-all group\" data-kid=\"1-1-2-4\" data-name=\"find donor link\" href=\"#\">\n                <i class=\"ti ti-search text-lg\" data-kid=\"1-1-2-4-1\" data-name=\"search donor icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"find donor label\">\n                    Find Matching Donor\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-slate-500 hover:text-[#0F766E] hover:bg-teal-50 rounded-xl transition-all group\" data-kid=\"1-1-2-5\" data-name=\"patient cases link\" href=\"#\">\n                <i class=\"ti ti-users text-lg\" data-kid=\"1-1-2-5-1\" data-name=\"patient cases icon\">\n                </i>\n                <span data-kid=\"1-1-2-5-2\" data-name=\"patient cases label\">\n                    Patient Cases\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-slate-500 hover:text-[#0F766E] hover:bg-teal-50 rounded-xl transition-all group\" data-kid=\"1-1-2-6\" data-name=\"prediction history link\" href=\"#\">\n                <i class=\"ti ti-history text-lg\" data-kid=\"1-1-2-6-1\" data-name=\"prediction history icon\">\n                </i>\n                <span data-kid=\"1-1-2-6-2\" data-name=\"prediction history label\">\n                    Prediction History\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-bold text-[#0F766E] bg-teal-50 border-l-4 border-[#0F766E] rounded-r-xl transition-all group shadow-sm\" data-kid=\"1-1-2-7\" data-name=\"active clinical reports link\" href=\"#\">\n                <i class=\"ti ti-file-analytics text-lg\" data-kid=\"1-1-2-7-1\" data-name=\"clinical reports icon\">\n                </i>\n                <span data-kid=\"1-1-2-7-2\" data-name=\"clinical reports label\">\n                    Clinical Reports\n                </span>\n            </a>\n        </nav>\n        <div class=\"p-4 mt-auto space-y-4\" data-kid=\"1-1-3\" data-name=\"sidebar bottom actions\">\n            <div class=\"bg-[#dff7f2] p-4 rounded-xl border border-teal-100\" data-kid=\"1-1-3-1\" data-name=\"AI engine status indicator card\">\n                <div class=\"flex items-center gap-2 text-[#0F766E] mb-1\" data-kid=\"1-1-3-1-1\" data-name=\"AI engine status label group\">\n                    <i class=\"ti ti-wave-pulse animate-pulse\" data-kid=\"1-1-3-1-1-1\" data-name=\"pulsing wave icon\">\n                    </i>\n                    <span class=\"text-[11px] font-bold uppercase\" data-kid=\"1-1-3-1-1-2\" data-name=\"AI engine status text\">\n                        AI Engine Online\n                    </span>\n                </div>\n                <p class=\"text-[10px] text-teal-800/70\" data-kid=\"1-1-3-1-2\" data-name=\"model version accuracy text\">\n                    Model v3.2 · 94.6% accuracy\n                </p>\n            </div>\n            <button class=\"flex items-center gap-3 w-full px-3 py-2 text-[13px] font-medium text-rose-500 hover:bg-rose-50 rounded-xl transition-all\" data-kid=\"1-1-3-2\" data-name=\"logout button\">\n                <i class=\"ti ti-logout text-lg\" data-kid=\"1-1-3-2-1\" data-name=\"logout icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"logout label\">\n                    Logout\n                </span>\n            </button>\n        </div>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"flex-1 ml-0 md:ml-[228px] flex flex-col min-w-0 transition-all\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Top Navigation -->\n        <header class=\"h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 md:px-8 sticky top-0 z-40\" data-kid=\"1-2-1\" data-name=\"top navigation bar\">\n            <div class=\"flex items-center gap-4 flex-1\" data-kid=\"1-2-1-1\" data-name=\"top nav left tools\">\n                <button class=\"md:hidden p-2 text-slate-500 hover:bg-slate-50 rounded-lg\" data-kid=\"1-2-1-1-1\" data-name=\"sidebar toggle button\">\n                    <i class=\"ti ti-menu-2 text-xl\" data-kid=\"1-2-1-1-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n                <p class=\"text-[12px] text-slate-400 font-medium hidden lg:block\" data-kid=\"1-2-1-1-2\" data-name=\"platform platform descriptor text\">\n                    AI Powered Organ Donation Matching Platform\n                </p>\n                <div class=\"relative w-full max-w-md ml-4\" data-kid=\"1-2-1-1-3\" data-name=\"global search input wrapper\">\n                    <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-kid=\"1-2-1-1-3-1\" data-name=\"search glass icon\">\n                    </i>\n                    <input class=\"w-full bg-slate-50 border-none rounded-lg py-2 pl-10 pr-4 text-[13px] focus:ring-1 focus:ring-teal-500 outline-hidden transition-all\" data-kid=\"1-2-1-1-3-2\" data-name=\"search input field\" placeholder=\"Search patients, donors, predictions...\" type=\"text\"/>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"top nav right user tools\">\n                <button class=\"w-10 h-10 flex items-center justify-center text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-50 transition-all relative\" data-kid=\"1-2-1-2-1\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-xl\" data-kid=\"1-2-1-2-1-1\" data-name=\"bell notification icon\">\n                    </i>\n                    <span class=\"absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full border-2 border-white\" data-kid=\"1-2-1-2-1-2\" data-name=\"notification indicator dot\">\n                    </span>\n                </button>\n                <div class=\"h-8 w-[1px] bg-slate-200\" data-kid=\"1-2-1-2-2\" data-name=\"divider line\">\n                </div>\n                <div class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"1-2-1-2-3\" data-name=\"user profile summary\">\n                    <div class=\"text-right\" data-kid=\"1-2-1-2-3-1\" data-name=\"user identity text container\">\n                        <p class=\"text-[13px] font-bold text-slate-900 leading-none\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"doctor name label\">\n                            Dr. Ayesha Raza\n                        </p>\n                        <p class=\"text-[11px] text-slate-400 font-medium\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"institute label\">\n                            St. Mary Institute\n                        </p>\n                    </div>\n                    <div class=\"w-9 h-9 bg-teal-700 rounded-full flex items-center justify-center text-white font-bold text-sm\" data-kid=\"1-2-1-2-3-2\" data-name=\"user profile avatar placeholder\">\n                        AR\n                    </div>\n                </div>\n            </div>\n