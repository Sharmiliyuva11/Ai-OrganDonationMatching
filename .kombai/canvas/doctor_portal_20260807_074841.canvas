      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    \n    :root {\n        --primary-teal: #0F766E;\n        --primary-mint: #DCF2F1;\n        --bg-gray: #F8FAFB;\n        --text-dark: #1E293B;\n        --text-muted: #64748B;\n        --border-color: #E2E8F0;\n    }\n\n    .doctor-portal-body {\n        font-family: 'Inter', sans-serif;\n        background-color: var(--bg-gray);\n        color: var(--text-dark);\n        margin: 0;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: #CBD5E1;\n        border-radius: 10px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n        background: #94A3B8;\n    }\n\n    .no-x-scroll {\n        overflow-x: clip;\n    }\n\n    .sidebar-active {\n        background-color: #E6F4F1;\n        color: #0F766E;\n        position: relative;\n    }\n    .sidebar-active::before {\n        content: '';\n        position: absolute;\n        left: 0;\n        top: 20%;\n        bottom: 20%;\n        width: 3px;\n        background-color: #0F766E;\n        border-radius: 0 4px 4px 0;\n    }\n\n    .card-shadow {\n        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.03);\n    }\n    \n    .btn-teal {\n        background-color: #0F766E;\n        color: white;\n    }\n    \n    .btn-teal:hover {\n        background-color: #0D635D;\n    }\n</style>\n<div class=\"doctor-portal-body flex h-screen no-x-scroll antialiased text-[14px]\" data-kid=\"1\" data-name=\"doctor portal layout container\">\n    <!-- Sidebar -->\n    <aside class=\"w-[228px] bg-white border-r border-slate-200 flex flex-col shrink-0 z-50\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <div class=\"p-5 flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand identity container\">\n            <div class=\"w-8 h-8 bg-[#0F766E] rounded-lg flex items-center justify-center text-white shadow-sm\" data-kid=\"1-1-1-1\" data-name=\"heart pulse icon container\">\n                <i class=\"w-5 h-5\" data-kid=\"1-1-1-1-1\" data-lucide=\"heart-pulse\" data-name=\"heart pulse icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"application title container\">\n                <h1 class=\"font-bold text-[16px] text-[#0F766E] leading-tight\" data-kid=\"1-1-1-2-1\" data-name=\"application name headline\">\n                    OrganLink AI\n                </h1>\n                <p class=\"text-[10px] text-slate-400 uppercase tracking-widest font-bold\" data-kid=\"1-1-1-2-2\" data-name=\"application sub-label\">\n                    Doctor Portal\n                </p>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-3 py-4 space-y-1 overflow-y-auto custom-scrollbar\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <p class=\"px-3 mb-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"1-1-2-1\" data-name=\"navigation section header\">\n                Clinical\n            </p>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-2\" data-name=\"dashboard navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-2-1\" data-lucide=\"layout-grid\" data-name=\"dashboard grid icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-2-2\" data-name=\"dashboard label\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-3\" data-name=\"ai match prediction link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-3-1\" data-lucide=\"microscope\" data-name=\"microscope icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-3-2\" data-name=\"ai match prediction label\">\n                    AI Match Prediction\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 sidebar-active rounded-lg transition-colors group\" data-kid=\"1-1-2-4\" data-name=\"find matching donor navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-4-1\" data-lucide=\"search\" data-name=\"search icon\">\n                </i>\n                <span class=\"font-bold text-[13px]\" data-kid=\"1-1-2-4-2\" data-name=\"find matching donor label\">\n                    Find Matching Donor\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-5\" data-name=\"patient cases navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-5-1\" data-lucide=\"users\" data-name=\"users icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-5-2\" data-name=\"patient cases label\">\n                    Patient Cases\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-6\" data-name=\"recommended matches navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-6-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-6-2\" data-name=\"recommended matches label\">\n                    Recommended Matches\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-7\" data-name=\"prediction history navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-7-1\" data-lucide=\"history\" data-name=\"history icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-7-2\" data-name=\"prediction history label\">\n                    Prediction History\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors group\" data-kid=\"1-1-2-8\" data-name=\"clinical reports navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-2-8-1\" data-lucide=\"file-bar-chart\" data-name=\"file bar chart icon\">\n                </i>\n                <span class=\"font-medium text-[13px]\" data-kid=\"1-1-2-8-2\" data-name=\"clinical reports label\">\n                    Clinical Reports\n                </span>\n            </a>\n        </nav>\n        <div class=\"p-4 space-y-4\" data-kid=\"1-1-3\" data-name=\"sidebar utility section\">\n            <div class=\"bg-[#E6F4F1] p-3 rounded-xl border border-[#0F766E]/10\" data-kid=\"1-1-3-1\" data-name=\"ai engine status card\">\n                <div class=\"flex items-center gap-2 mb-1\" data-kid=\"1-1-3-1-1\" data-name=\"ai engine status header\">\n                    <i class=\"w-4 h-4 text-[#0F766E]\" data-kid=\"1-1-3-1-1-1\" data-lucide=\"activity\" data-name=\"activity icon\">\n                    </i>\n                    <span class=\"text-[12px] font-bold text-[#0F766E]\" data-kid=\"1-1-3-1-1-2\" data-name=\"ai engine online status text\">\n                        AI Engine Online\n                    </span>\n                </div>\n                <p class=\"text-[11px] text-slate-500\" data-kid=\"1-1-3-1-2\" data-name=\"ai model version accuracy text\">\n                    Model v3.2 · 94.6% accuracy\n                </p>\n            </div>\n            <a class=\"flex items-center gap-3 px-3 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors font-semibold text-[13px]\" data-kid=\"1-1-3-2\" data-name=\"logout navigation link\" href=\"#\">\n                <i class=\"w-[18px] h-[18px]\" data-kid=\"1-1-3-2-1\" data-lucide=\"log-out\" data-name=\"log out icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"logout label\">\n                    Logout\n                </span>\n            </a>\n        </div>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"flex-1 flex flex-col h-screen overflow-hidden\" data-kid=\"1-2\" data-name=\"main page content area\">\n        <!-- Top Nav -->\n        <header class=\"h-[64px] bg-white border-b border-slate-200 px-8 flex items-center justify-between shrink-0\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-1\" data-name=\"platform branding container\">\n                <div class=\"text-slate-500 font-medium text-[13px]\" data-kid=\"1-2-1-1-1\" data-name=\"platform description text\">\n                    AI Powered Organ Donation Matching Platform\n                </div>\n                <div class=\"h-4 w-px bg-slate-200\" data-kid=\"1-2-1-1-2\" data-name=\"header separator\">\n                </div>\n                <div class=\"text-slate-400 text-[12px]\" data-kid=\"1-2-1-1-3\" data-name=\"current date text\">\n                    Thursday, Aug 6, 2026\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-2-1-2\" data-name=\"header action container\">\n                <div class=\"relative\" data-kid=\"1-2-1-2-1\" data-name=\"global search field container\">\n                    <i class=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-300\" data-kid=\"1-2-1-2-1-1\" data-lucide=\"search\" data-name=\"global search icon\">\n                    </i>\n                    <input class=\"bg-[#F8FAFB] border border-slate-100 rounded-full pl-9 pr-4 py-1.5 w-[280px] text-[13px] focus:outline-hidden focus:border-slate-300 transition-all placeholder:text-slate-300\" data-kid=\"1-2-1-2-1-2\" data-name=\"global search input field\" placeholder=\"Search patients, donors...\" type=\"text\"/>\n                </div>\n                <button class=\"relative text-slate-400 hover:text-slate-600 transition-colors cursor-pointer\" data-kid=\"1-2-1-2-2\" data-name=\"notification bell button\">\n                    <i class=\"w-5 h-5\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"bell\" data-name=\"notification bell icon\">\n                    </i>\n                    <span class=\"absolute -top-1.5 -right-1.5 w-[15px] h-[15px] bg-red-500 text-white text-[9px] flex items-center justify-center rounded-full border-2 border-white leading-none font-bold\" data-kid=\"1-2-1-2-2-2\" data-name=\"notification counter badge\">\n                        3\n                    </span>\n                </button>\n                <div class=\"flex items-center gap-3 pl-2\" data-kid=\"1-2-1-2-3\" data-name=\"user profile container\">\n                    <div class=\"text-right\" data-kid=\"1-2-1-2-3-1\" data-name=\"user identity text container\">\n                        <p class=\"text-[13px] font-bold text-slate-800 leading-tight\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"doctor name text\">\n                            Dr. Ayesha Raza\n                        </p>\n                        <p class=\"text-[11px] text-slate-400 font-medium\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"hospital affiliation text\">\n                            St. Mary Institute of Transplant Medicine\n                        </p>\n                    </div>\n                    <div class=\"w-9 h-9 bg-[#0F766E] rounded-lg flex items-center justify-center text-white font-bold text-[14px]\" data-kid=\"1-2-1-2-3-2\" data-name=\"user avatar initial\">\n                        AR\n                    </div>\n                </div>\n            </div>\n        </header>\n        <!-- Page Workspace -->\n        <div class=\"flex-1 overflow-y-auto custom-scrollbar p-8 bg-[#F8FAFB]\" data-kid=\"1-2-2\" data-name=\"workspace content container\">\n            <!-- Page Header -->\n            <div class=\"flex justify-between items-start mb-8\" data-kid=\"1-2-2-1\" data-name=\"page header container\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"page title container\">\n                    <h2 class=\"text-[26px] font-bold text-slate-900 tracking-tight\" data-kid=\"1-2-2-1-1-1\" data-name=\"page headline text\">\n                        Find Matching Donor\n                    </h2>\n                    <p class=\"text-slate-500 mt-1 font-medium text-[15px]\" data-kid=\"1-2-2-1-1-2\" data-name=\"page description text\">\n                        Search and review donors compatible with your recipients\n                    </p>\n                </div>\n                <button class=\"btn-teal px-5 py-2.5 rounded-lg flex items-center gap-2 font-bold hover:shadow-lg transition-all shadow-[#0F766E]/20 text-[14px] cursor-pointer\" data-kid=\"1-2-2-1-2\" data-name=\"new prediction call-to-action button\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"plus-circle\" data-name=\"add icon\">\n                    </i>\n                    New Prediction\n                </button>\n            </div>\n            <!-- Filter Panel -->\n            <section class=\"bg-white rounded-[14px] border border-slate-200 card-shadow p-6 mb-8\" data-kid=\"1-2-2-2\" data-name=\"donor filter panel\">\n                <div class=\"flex flex-col gap-6\" data-kid=\"1-2-2-2-1\" data-name=\"filter layout container\">\n                    <div class=\"grid grid-cols-12 gap-6\" data-kid=\"1-2-2-2-1-1\" data-name=\"primary filter row\">\n                        <div class=\"col-span-12 lg:col-span-4\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"donor search field container\">\n                            <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"donor search label\">\n                                Search Donor\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-2-2-1-1-1-2\" data-name=\"donor search input wrapper\">\n                                <i class=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-kid=\"1-2-2-2-1-1-1-2-1\" data-lucide=\"search\" data-name=\"donor search icon\">\n                                </i>\n                                <input class=\"w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50 transition-all\" data-kid=\"1-2-2-2-1-1-1-2-2\" data-name=\"donor search input field\" placeholder=\"Enter Donor ID or Name...\" type=\"text\"/>\n                            </div>\n                        </div>\n                        <div class=\"col-span-12 lg:col-span-8\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"secondary filter column\">\n                            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"secondary filter grid\">\n                                <div data-kid=\"1-2-2-2-1-1-2-1-1\" data-name=\"recipient id container\">\n                                    <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-1-2-1-1-1\" data-name=\"recipient id label\">\n                                        Recipient ID\n                                    </label>\n                                    <input class=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50\" data-kid=\"1-2-2-2-1-1-2-1-1-2\" data-name=\"recipient id input field\" placeholder=\"PT-10xxx\" type=\"text\"/>\n                                </div>\n                                <div data-kid=\"1-2-2-2-1-1-2-1-2\" data-name=\"blood group container\">\n                                    <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-1-2-1-2-1\" data-name=\"blood group label\">\n                                        Blood Group\n                                    </label>\n                                    <select class=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_0.5rem_center] bg-no-repeat cursor-pointer\" data-kid=\"1-2-2-2-1-1-2-1-2-2\" data-name=\"blood group select dropdown\">\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-2-2-1\" data-name=\"blood group default option\" value=\"\">\n                                            All Groups\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-2-2-2\" data-name=\"blood group a+ option\">\n                                            A+\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-2-2-3\" data-name=\"blood group o- option\">\n                                            O-\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-2-2-4\" data-name=\"blood group b+ option\">\n                                            B+\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-2-2-5\" data-name=\"blood group ab- option\">\n                                            AB-\n                                        </option>\n                                    </select>\n                                </div>\n                                <div data-kid=\"1-2-2-2-1-1-2-1-3\" data-name=\"organ needed container\">\n                                    <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-1-2-1-3-1\" data-name=\"organ needed label\">\n                                        Organ Needed\n                                    </label>\n                                    <select class=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_0.5rem_center] bg-no-repeat cursor-pointer\" data-kid=\"1-2-2-2-1-1-2-1-3-2\" data-name=\"organ needed select dropdown\">\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-3-2-1\" data-name=\"organ needed default option\" value=\"\">\n                                            All Organs\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-3-2-2\" data-name=\"organ needed kidney option\">\n                                            Kidney\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-3-2-3\" data-name=\"organ needed liver option\">\n                                            Liver\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-3-2-4\" data-name=\"organ needed heart option\">\n                                            Heart\n                                        </option>\n                                        <option data-kid=\"1-2-2-2-1-1-2-1-3-2-5\" data-name=\"organ needed lung option\">\n                                            Lung\n                                        </option>\n                                    </select>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-12 gap-6\" data-kid=\"1-2-2-2-1-2\" data-name=\"tertiary filter row\">\n                        <div class=\"col-span-12 lg:col-span-8\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"location filters column\">\n                            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"location filters grid\">\n                                <div data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"hospital filter container\">\n                                    <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-2-1-1-1-1\" data-name=\"hospital filter label\">\n                                        Hospital\n                                    </label>\n                                    <input class=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50\" data-kid=\"1-2-2-2-1-2-1-1-1-2\" data-name=\"hospital filter input field\" placeholder=\"Preferred Institution\" type=\"text\"/>\n                                </div>\n                                <div data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"city filter container\">\n                                    <label class=\"block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2\" data-kid=\"1-2-2-2-1-2-1-1-2-1\" data-name=\"city filter label\">\n                                        City\n                                    </label>\n                                    <input class=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-[14px] focus:outline-hidden focus:border-[#0F766E]/50\" data-kid=\"1-2-2-2-1-2-1-1-2-2\" data-name=\"city filter input field\" placeholder=\"Preferred City\" type=\"text\"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-span-12 lg:col-span-4 flex items-end justify-end gap-3 pb-0.5\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"filter action container\">\n                            <button class=\"px-6 py-2.5 border border-slate-200 rounded-lg text-slate-500 font-bold hover:bg-slate-50 transition-all text-[13px] cursor-pointer\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"reset filter button\">\n                                Reset\n                            </button>\n                            <button class=\"px-8 py-2.5 btn-teal rounded-lg font-bold transition-all flex items-center gap-2 text-[13px] shadow-sm shadow-[#0F766E]/20 cursor-pointer\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"search filter button\">\n                                <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-lucide=\"search\" data-name=\"filter search icon\">\n                                </i>\n                                Search\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Results Sect