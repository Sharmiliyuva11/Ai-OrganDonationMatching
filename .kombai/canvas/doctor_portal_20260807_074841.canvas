s=\"px-6 py-4\" data-kid=\"1-2-2-5-2-1-2-4-4\" data-name=\"cell 4-4\">\n                                    <span class=\"px-2.5 py-1 rounded-full bg-sky-50 text-sky-600 text-[11px] font-bold uppercase\" data-kid=\"1-2-2-5-2-1-2-4-4-1\" data-name=\"organ badge 4\">\n                                        Cornea\n                                    </span>\n                                </td>\n                                <td class=\"px-6 py-4 text-[13px] text-slate-600 font-medium\" data-kid=\"1-2-2-5-2-1-2-4-5\" data-name=\"date cell 4\">\n                                    Aug 10, 2026\n                                </td>\n                                <td class=\"px-6 py-4\" data-kid=\"1-2-2-5-2-1-2-4-6\" data-name=\"action cell 4\">\n                                    <button class=\"p-2 text-slate-400 hover:text-[#0F766E] hover:bg-white hover:border-[#0F766E] border border-transparent rounded-lg transition-all\" data-kid=\"1-2-2-5-2-1-2-4-6-1\" data-name=\"download button 4\" title=\"Download PDF\">\n                                        <i class=\"ti ti-download text-lg\" data-kid=\"1-2-2-5-2-1-2-4-6-1-1\" data-name=\"download icon 4\">\n                                        </i>\n                                    </button>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"p-4 border-t border-slate-100 flex items-center justify-between\" data-kid=\"1-2-2-5-3\" data-name=\"pagination footer\">\n                    <p class=\"text-[12px] text-slate-400\" data-kid=\"1-2-2-5-3-1\" data-name=\"pagination info text\">\n                        Showing 4 of 124 reports\n                    </p>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-5-3-2\" data-name=\"pagination controls\">\n                        <button class=\"p-2 text-slate-400 hover:text-[#0F766E] hover:bg-teal-50 border border-slate-200 rounded-lg disabled:opacity-30 transition-all\" data-kid=\"1-2-2-5-3-2-1\" data-name=\"prev page button\" disabled=\"\">\n                            <i class=\"ti ti-chevron-left\" data-kid=\"1-2-2-5-3-2-1-1\" data-name=\"left arrow icon\">\n                            </i>\n                        </button>\n                        <button class=\"w-9 h-9 rounded-lg bg-[#0F766E] text-white text-[12px] font-bold shadow-sm\" data-kid=\"1-2-2-5-3-2-2\" data-name=\"page 1 button\">\n                            1\n                        </button>\n                        <button class=\"w-9 h-9 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-500 text-[12px] font-bold transition-all\" data-kid=\"1-2-2-5-3-2-3\" data-name=\"page 2 button\">\n                            2\n                        </button>\n                        <button class=\"w-9 h-9 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-500 text-[12px] font-bold transition-all\" data-kid=\"1-2-2-5-3-2-4\" data-name=\"page 3 button\">\n                            3\n                        </button>\n                        <button class=\"p-2 text-slate-400 hover:text-[#0F766E] hover:bg-teal-50 border border-slate-200 rounded-lg transition-all\" data-kid=\"1-2-2-5-3-2-5\" data-name=\"next page button\">\n                            <i class=\"ti ti-chevron-right\" data-kid=\"1-2-2-5-3-2-5-1\" data-name=\"right arrow icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\">\n</script>\n<link data-kid=\"2\" data-name=\"Tabler icons CSS library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  \n  body {\n    font-family: 'Inter', sans-serif;\n  }\n\n  /* Custom scrollbar */\n  ::-webkit-scrollbar {\n    width: 6px;\n    height: 6px;\n  }\n  ::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #e2e8f0;\n    border-radius: 10px;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: #cbd5e1;\n  }\n  \n  .success-bar {\n    width: 0;\n  }\n</style>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n    // Entrance Animations\n    gsap.from(\".stat-card-anim\", {\n      opacity: 0,\n      y: 20,\n      stagger: 0.1,\n      duration: 0.6,\n      ease: \"power2.out\"\n    });\n\n    gsap.from(\".chart-card-anim\", {\n      opacity: 0,\n      y: 30,\n      stagger: 0.2,\n      duration: 0.8,\n      ease: \"power2.out\",\n      delay: 0.3\n    });\n\n    gsap.from(\"#reports-table-card\", {\n      opacity: 0,\n      y: 40,\n      duration: 1,\n      ease: \"power2.out\",\n      delay: 0.6\n    });\n\n    // Animate Success Bars\n    gsap.to(\".success-bar\", {\n      width: (i, el) => el.getAttribute('data-width'),\n      duration: 1.5,\n      ease: \"expo.out\",\n      delay: 0.8,\n      stagger: 0.1\n    });\n\n    // Compatibility Trend Chart\n    const ctxTrend = document.getElementById('compatibilityTrendChart').getContext('2d');\n    const trendGradient = ctxTrend.createLinearGradient(0, 0, 0, 300);\n    trendGradient.addColorStop(0, 'rgba(15, 118, 110, 0.1)');\n    trendGradient.addColorStop(1, 'rgba(15, 118, 110, 0)');\n\n    new Chart(ctxTrend, {\n      type: 'line',\n      data: {\n        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],\n        datasets: [{\n          label: 'Avg Compatibility %',\n          data: [84, 86, 85, 89, 87, 91],\n          borderColor: '#0F766E',\n          borderWidth: 3,\n          backgroundColor: trendGradient,\n          fill: true,\n          tension: 0.4,\n          pointRadius: 4,\n          pointBackgroundColor: '#fff',\n          pointBorderColor: '#0F766E',\n          pointBorderWidth: 2,\n          pointHoverRadius: 6\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: { display: false },\n          tooltip: {\n            backgroundColor: '#1e293b',\n            titleFont: { size: 12, weight: 'bold' },\n            bodyFont: { size: 12 },\n            padding: 12,\n            cornerRadius: 8,\n            displayColors: false\n          }\n        },\n        scales: {\n          y: {\n            min: 80,\n            max: 100,\n            ticks: {\n              stepSize: 5,\n              callback: value => value + '%',\n              font: { size: 11, weight: '500' },\n              color: '#94a3b8'\n            },\n            grid: {\n              color: '#f1f5f9'\n            },\n            border: { display: false }\n          },\n          x: {\n            ticks: {\n              font: { size: 11, weight: '500' },\n              color: '#94a3b8'\n            },\n            grid: { display: false },\n            border: { display: false }\n          }\n        }\n      }\n    });\n\n    // Organ Distribution Chart\n    const ctxDist = document.getElementById('organDistributionChart').getContext('2d');\n    new Chart(ctxDist, {\n      type: 'doughnut',\n      data: {\n        labels: ['Kidney', 'Liver', 'Heart', 'Lung', 'Cornea'],\n        datasets: [{\n          data: [42, 28, 15, 10, 5],\n          backgroundColor: [\n            '#0F766E',\n            '#34d399',\n            '#38bdf8',\n            '#818cf8',\n            '#fbbf24'\n          ],\n          borderWidth: 0,\n          hoverOffset: 4\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        cutout: '75%',\n        plugins: {\n          legend: { display: false },\n          tooltip: {\n            backgroundColor: '#1e293b',\n            padding: 10,\n            cornerRadius: 8,\n            displayColors: true\n          }\n        }\n      }\n    });\n  });\n</script>\n",
