                    <div class=\"w-6 h-6 bg-white rounded-md flex items-center justify-center shadow-xs shrink-0\" data-kid=\"3-2-2-3-2-3-2-3-1\" data-name=\"hospital icon container\">\n                                    <i class=\"fa-solid fa-hospital text-gray-400 text-[10px]\" data-kid=\"3-2-2-3-2-3-2-3-1-1\" data-name=\"hospital icon\">\n                                    </i>\n                                </div>\n                                <span class=\"text-[11px] text-gray-500 font-medium truncate\" data-kid=\"3-2-2-3-2-3-2-3-2\" data-name=\"location text\">\n                                    Grand Health · Islamabad\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"space-y-4 mb-8 flex-1\" data-kid=\"3-2-2-3-2-3-3\" data-name=\"compatibility and confidence progress\">\n                            <div data-kid=\"3-2-2-3-2-3-3-1\" data-name=\"compatibility score bar\">\n                                <div class=\"flex justify-between text-[11px] mb-2\" data-kid=\"3-2-2-3-2-3-3-1-1\" data-name=\"compatibility header\">\n                                    <span class=\"text-gray-400 font-bold uppercase tracking-wider\" data-kid=\"3-2-2-3-2-3-3-1-1-1\" data-name=\"compatibility title\">\n                                        Compatibility Score\n                                    </span>\n                                    <span class=\"text-[#0F766E] font-black\" data-kid=\"3-2-2-3-2-3-3-1-1-2\" data-name=\"compatibility value\">\n                                        84%\n                                    </span>\n                                </div>\n                                <div class=\"h-2.5 bg-gray-100 rounded-full overflow-hidden\" data-kid=\"3-2-2-3-2-3-3-1-2\" data-name=\"bar container\">\n                                    <div class=\"h-full bg-teal-500/60 rounded-full w-[84%]\" data-kid=\"3-2-2-3-2-3-3-1-2-1\" data-name=\"bar fill\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"3-2-2-3-2-3-3-2\" data-name=\"confidence and extra stats\">\n                                <span class=\"bg-blue-50 text-blue-600 px-3 py-1.5 rounded-full text-[10px] font-bold border border-blue-100\" data-kid=\"3-2-2-3-2-3-3-2-1\" data-name=\"AI confidence badge\">\n                                    AI Confidence 80%\n                                </span>\n                                <div class=\"flex gap-3\" data-kid=\"3-2-2-3-2-3-3-2-2\" data-name=\"medical detail tags\">\n                                    <div class=\"flex items-center gap-1.5\" data-kid=\"3-2-2-3-2-3-3-2-2-1\" data-name=\"HLA detail tag\" title=\"HLA: 4/6 Matches\">\n                                        <i class=\"fa-solid fa-dna text-gray-300 text-[10px]\" data-kid=\"3-2-2-3-2-3-3-2-2-1-1\" data-name=\"DNA icon\">\n                                        </i>\n                                        <span class=\"text-[10px] text-gray-700 font-bold\" data-kid=\"3-2-2-3-2-3-3-2-2-1-2\" data-name=\"HLA value\">\n                                            4/6\n                                        </span>\n                                    </div>\n                                    <div class=\"flex items-center gap-1.5\" data-kid=\"3-2-2-3-2-3-3-2-2-2\" data-name=\"infection detail tag\" title=\"Infection Status: Negative\">\n                                        <i class=\"fa-solid fa-shield-virus text-teal-500 text-[10px]\" data-kid=\"3-2-2-3-2-3-3-2-2-2-1\" data-name=\"shield icon\">\n                                        </i>\n                                        <span class=\"text-[10px] text-teal-600 font-bold\" data-kid=\"3-2-2-3-2-3-3-2-2-2-2\" data-name=\"infection status value\">\n                                            Neg.\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-3 mt-auto\" data-kid=\"3-2-2-3-2-3-4\" data-name=\"donor action buttons\">\n                            <button class=\"px-4 py-2.5 border border-[#e5e7eb] rounded-xl text-xs font-bold text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-all active:scale-95\" data-kid=\"3-2-2-3-2-3-4-1\" data-name=\"view details button\">\n                                View Details\n                            </button>\n                            <button class=\"px-4 py-2.5 bg-[#0F766E] text-white rounded-xl text-xs font-bold hover:bg-[#0d6b63] transition-all shadow-sm active:scale-95\" data-kid=\"3-2-2-3-2-3-4-2\" data-name=\"generate report button\">\n                                Generate Report\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n<!-- Scripts for animations -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis for smooth scrolling\n    const lenis = new Lenis({\n        autoRaf: true,\n    });\n\n    // Entrance animations using gsap.from (safe to destination)\n    // We don't hide with CSS to follow constraints\n    gsap.from(\".animate-entrance\", {\n        opacity: 0,\n        y: 30,\n        duration: 1,\n        stagger: 0.12,\n        ease: \"expo.out\",\n        delay: 0.2,\n        clearProps: \"opacity,transform\" // Only clear what we touched\n    });\n\n    // Interactive \"Run Prediction\" effect\n    const runBtn = document.getElementById('runPrediction');\n    if(runBtn) {\n        runBtn.addEventListener('click', () => {\n            gsap.to(\".animate-entrance\", {\n                scale: 0.99,\n                opacity: 0.7,\n                duration: 0.2,\n                yoyo: true,\n                repeat: 1,\n                stagger: 0.05,\n                ease: \"power2.inOut\"\n            });\n        });\n    }\n</script>\n",
      "comments": [],
      "created": "2026-08-07T07:49:25.937359+00:00",
      "modified": "2026-08-07T07:49:25.937359+00:00",
      "id": "var_847750ddd656",
      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "bodyAttrs": " class=\"antialiased\"",
        "head": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>AI Match Prediction - OrganLink AI</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>"
      }
    },
    "var_7c41afe9ccc1": {
      "type": "variant",
      "label": "Doctor Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n\n    .font-inter {\n        font-family: 'Inter', sans-serif;\n    }\n    \n    .sidebar-item-active {\n        background-color: #dff7f2;\n        color: #0F766E;\n        font-weight: 500;\n    }\n    \n    .scrollbar-hide::-webkit-scrollbar {\n        display: none;\n    }\n    \n    .scrollbar-hide {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    .stat-card-hover:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);\n    }\n</style>\n<div class=\"font-inter min-h-screen bg-[#f7fafb] text-[#1a202c] relative\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Mobile Menu Backdrop -->\n    <div class=\"fixed inset-0 bg-black/50 z-40 hidden transition-opacity lg:hidden\" data-kid=\"1-1\" data-name=\"mobile menu backdrop\" id=\"mobile-backdrop\">\n    </div>\n    <!-- Sidebar -->\n    <aside class=\"fixed inset-y-0 left-0 w-[228px] bg-white border-r border-[#e5e7eb] transform -translate-x-full lg:translate-x-0 transition-transform duration-300 z-50 flex flex-col\" data-kid=\"1-2\" data-name=\"sidebar navigation container\" id=\"sidebar\">\n        <div class=\"p-5 flex items-center gap-2\" data-kid=\"1-2-1\" data-name=\"sidebar profile info header\">\n            <div class=\"w-8 h-8 bg-[#0F766E] rounded-lg flex items-center justify-center\" data-kid=\"1-2-1-1\" data-name=\"heart pulse icon\">\n                <i class=\"text-white w-5 h-5\" data-kid=\"1-2-1-1-1\" data-lucide=\"heart-pulse\">\n                </i>\n            </div>\n            <div data-kid=\"1-2-1-2\" data-name=\"application title branding block\">\n                <h1 class=\"text-[#111827] font-bold text-sm tracking-tight\" data-kid=\"1-2-1-2-1\" data-name=\"application name title\">\n                    OrganLink AI\n                </h1>\n                <p class=\"text-[10px] text-gray-400 -mt-1\" data-kid=\"1-2-1-2-2\" data-name=\"application role subtitle\">\n                    Doctor Portal\n                </p>\n            </div>\n        </div>\n        <div class=\"mt-4 px-5\" data-kid=\"1-2-2\" data-name=\"sidebar clinical navigation menu\">\n            <p class=\"text-[10px] font-semibold text-gray-400 tracking-widest uppercase mb-4\" data-kid=\"1-2-2-1\" data-name=\"clinical menu header\">\n                CLINICAL\n            </p>\n            <nav class=\"space-y-1\" data-kid=\"1-2-2-2\" data-name=\"clinical navigation links list\">\n                <a class=\"sidebar-item-active flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-1\" data-name=\"active dashboard link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-1-1\" data-lucide=\"layout-grid\" data-name=\"dashboard grid icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-1-2\" data-name=\"dashboard link text\">\n                        Dashboard\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-2\" data-name=\"ai match prediction link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-2-1\" data-lucide=\"zap\" data-name=\"zap icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-2-2\" data-name=\"ai match prediction text\">\n                        AI Match Prediction\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-3\" data-name=\"find matching donor link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-3-1\" data-lucide=\"search\" data-name=\"search icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-3-2\" data-name=\"find matching donor text\">\n                        Find Matching Donor\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-4\" data-name=\"patient cases link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-4-1\" data-lucide=\"users\" data-name=\"users icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-4-2\" data-name=\"patient cases text\">\n                        Patient Cases\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-5\" data-name=\"recommended matches link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-5-1\" data-lucide=\"star\" data-name=\"star icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-5-2\" data-name=\"recommended matches text\">\n                        Recommended Matches\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-6\" data-name=\"prediction history link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-6-1\" data-lucide=\"history\" data-name=\"history icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-6-2\" data-name=\"prediction history text\">\n                        Prediction History\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2 text-gray-500 hover:text-[#0F766E] hover:bg-gray-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-2-2-7\" data-name=\"clinical reports link\" href=\"#\">\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-2-2-7-1\" data-lucide=\"file-text\" data-name=\"file text icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-7-2\" data-name=\"clinical reports text\">\n                        Clinical Reports\n                    </span>\n                </a>\n            </nav>\n        </div>\n        <div class=\"mt-auto px-4 pb-6 space-y-4\" data-kid=\"1-2-3\" data-name=\"sidebar bottom footer controls\">\n            <div class=\"bg-[#dff7f2] p-4 rounded-xl border border-[#b9e6dc]\" data-kid=\"1-2-3-1\" data-name=\"ai engine status card\">\n                <div class=\"flex items-center gap-2 mb-1\" data-kid=\"1-2-3-1-1\" data-name=\"status indicator row\">\n                    <div class=\"w-2 h-2 rounded-full bg-[#0F766E] animate-pulse\" data-kid=\"1-2-3-1-1-1\" data-name=\"ai engine status pulsing dot\">\n                    </div>\n                    <span class=\"text-[11px] font-semibold text-[#0F766E]\" data-kid=\"1-2-3-1-1-2\" data-name=\"ai engine status label\">\n                        AI Engine Online\n                    </span>\n                </div>\n                <p class=\"text-[10px] text-[#0F766E]/70\" data-kid=\"1-2-3-1-2\" data-name=\"ai engine version and accuracy text\">\n                    Model v3.2 · 94.6% accuracy\n                </p>\n            </div>\n            <button class=\"w-full flex items-center gap-3 px-4 py-2 text-red-500 hover:bg-red-50 rounded-lg text-sm transition-colors\" data-kid=\"1-2-3-2\" data-name=\"logout button\">\n                <i class=\"w-4 h-4\" data-kid=\"1-2-3-2-1\" data-lucide=\"log-out\" data-name=\"log out icon\">\n                </i>\n                <span class=\"font-medium\" data-kid=\"1-2-3-2-2\" data-name=\"logout button text\">\n                    Logout\n                </span>\n            </button>\n        </div>\n    </aside>\n    <!-- Main Content -->\n    <main class=\"lg:ml-[228px] transition-all duration-300\" data-kid=\"1-3\" data-name=\"main content area\">\n        <!-- Top Bar -->\n        <header class=\"h-16 bg-white border-b border-[#e5e7eb] sticky top-0 z-30 px-4 lg:px-8 flex items-center justify-between\" data-kid=\"1-3-1\" data-name=\"header top bar\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-3-1-1\" data-name=\"header left group\">\n                <button class=\"lg:hidden p-2 text-gray-500 hover:bg-gray-100 rounded-lg transition-colors\" data-kid=\"1-3-1-1-1\" data-name=\"mobile menu toggle button\" id=\"menu-toggle\">\n                    <i class=\"w-6 h-6\" data-kid=\"1-3-1-1-1-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n                <div class=\"hidden md:block\" data-kid=\"1-3-1-1-2\" data-name=\"header title info\">\n                    <h2 class=\"text-sm font-semibold text-gray-800\" data-kid=\"1-3-1-1-2-1\" data-name=\"platform description headline\">\n                        AI Powered Organ Donation Matching Platform\n                    </h2>\n                    <p class=\"text-[11px] text-gray-400\" data-kid=\"1-3-1-1-2-2\" data-name=\"current date text\">\n                        Thursday, Aug 6, 2026\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 lg:gap-6\" data-kid=\"1-3-1-2\" data-name=\"header right control group\">\n                <div class=\"relative hidden sm:block\" data-kid=\"1-3-1-2-1\" data-name=\"search input wrapper\">\n                    <i class=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400\" data-kid=\"1-3-1-2-1-1\" data-lucide=\"search\" data-name=\"search icon\">\n                    </i>\n                    <input class=\"bg-[#f3f4f6] text-xs rounded-full py-2 pl-9 pr-4 w-64 border-none focus:ring-2 focus:ring-[#0F766E]/20 outline-none transition-all\" data-kid=\"1-3-1-2-1-2\" data-name=\"search input field\" placeholder=\"Search patients, donors, predictions...\" type=\"text\"/>\n                </div>\n                <button class=\"relative p-2 text-gray-500 hover:bg-gray-100 rounded-full transition-colors\" data-kid=\"1-3-1-2-2\" data-name=\"notifications bell button\">\n                    <i class=\"w-5 h-5\" data-kid=\"1-3-1-2-2-1\" data-lucide=\"bell\" data-name=\"bell icon\">\n                    </i>\n                    <span class=\"absolute top-2 right-2 w-2 h-2 bg-red-500 border-2 border-white rounded-full\" data-kid=\"1-3-1-2-2-2\" data-name=\"notification unread indicator\">\n                    </span>\n                </button>\n                <div class=\"flex items-center gap-3 pl-4 border-l border-gray-200\" data-kid=\"1-3-1-2-3\" data-name=\"user profile summary\">\n                    <div class=\"hidden lg:block text-right\" data-kid=\"1-3-1-2-3-1\" data-name=\"user name and institution info\">\n                        <p class=\"text-xs font-semibold text-gray-900 leading-none\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"doctor name label\">\n                            Dr. Ayesha Raza\n                        </p>\n                        <p class=\"text-[10px] text-gray-500 mt-1\" data-kid=\"1-3-1-2-3-1-2\" data-name=\"institution name label\">\n                            St. Mary Institute of Transplant Medicine\n                        </p>\n                    </div>\n                    <div class=\"w-9 h-9 bg-[#0F766E] rounded-full flex items-center justify-center text-white text-xs font-bold ring-2 ring-[#dff7f2] cursor-pointer\" data-kid=\"1-3-1-2-3-2\" data-name=\"user profile avatar initials\">\n                        AR\n                    </div>\n                </div>\n            </div>\n        </header>\n        <!-- Dashboard Content Container -->\n        <div class=\"p-4 lg:p-8 max-w-[1212px] mx-auto\" data-kid=\"1-3-2\" data-name=\"dashboard content container\">\n            <!-- Greeting & Actions -->\n            <div class=\"dashboard-animate-item flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8\" data-kid=\"1-3-2-1\" data-name=\"greeting and actions header row\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"user greeting text block\">\n                    <h3 class=\"text-xl lg:text-2xl font-bold text-gray-900\" data-kid=\"1-3-2-1-1-1\" data-name=\"greeting headline\">\n                        Good morning, Dr. Ayesha Raza\n                    </h3>\n                    <p class=\"text-sm text-gray-500 mt-1\" data-kid=\"1-3-2-1-1-2\" data-name=\"professional role subtitle\">\n                        Transplant Surgeon · St. Mary Institute of Transplant Medicine\n                    </p>\n                </div>\n                <div class=\"flex gap-3\" data-kid=\"1-3-2-1-2\" data-name=\"action buttons group\">\n                    <button class=\"flex items-center gap-2 bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors shadow-sm\" data-kid=\"1-3-2-1-2-1\" data-name=\"new case button\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-3-2-1-2-1-1\" data-lucide=\"plus-square\" data-name=\"plus square icon\">\n                        </i>\n                        <span data-kid=\"1-3-2-1-2-1-2\" data-name=\"new case button text\">\n                            New Case\n                        </span>\n                    </button>\n                    <button class=\"flex items-center gap-2 bg-[#0F766E] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#0c635d] transition-colors shadow-md\" data-kid=\"1-3-2-1-2-2\" data-name=\"run ai prediction button\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-3-2-1-2-2-1\" data-lucide=\"wand-2\" data-name=\"wand icon\">\n                        </i>\n                        <span data-kid=\"1-3-2-1-2-2-2\" data-name=\"run ai prediction button text\">\n                            Run AI Prediction\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <!-- Stats Grid -->\n            <div class=\"dashboard-animate-item grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\" data-kid=\"1-3-2-2\" data-name=\"stats grid container\">\n                <!-- Stat Card 1 -->\n                <div class=\"stat-card-hover bg-white p-5 rounded-2xl border border-gray-100 shadow-sm transition-all duration-300\" data-kid=\"1-3-2-2-1\" data-name=\"patients stat card\">\n                    <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-2-2-1-1\" data-name=\"stat card header\">\n                        <div class=\"w-10 h-10 bg-[#dff7f2] rounded-xl flex items-center justify-center text-[#0F766E] shrink-0\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"users icon container\">\n                            <i class=\"w-5 h-5\" data-kid=\"1-3-2-2-1-1-1-1\" data-lucide=\"users\" data-name=\"users icon\">\n                            </i>\n                        </div>\n                        <span class=\"text-[10px] font-semibold text-teal-600 flex items-center gap-1 bg-teal-50 px-1.5 py-0.5 rounded-md border border-teal-100\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"patients stat trend badge\">\n                            <i class=\"w-2.5 h-2.5\" data-kid=\"1-3-2-2-1-1-2-1\" data-lucide=\"trending-up\" data-name=\"trending up icon\">\n                            </i>\n                            +12%\n                            <span class=\"text-gray-400 font-normal hidden xl:inline\" data-kid=\"1-3-2-2-1-1-2-2\" data-name=\"patients trend vs yesterday label\">\n                                vs yesterday\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"mt-4\" data-kid=\"1-3-2-2-1-2\" data-name=\"stat card body\">\n                        <p class=\"text-[10px] font-semibold text-gray-400 uppercase tracking-wider\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"patients label\">\n                            Today's Patients\n                        </p>\n                        <h4 class=\"text-2xl font-bold text-gray-900 mt-1\" data-kid=\"1-3-2-2-1-2-2\" data-name=\"patients count\">\n                            18\n                        </h4>\n                    </div>\n                </div>\n                <!-- Stat Card 2 -->\n                <div class=\"stat-card-hover bg-white p-5 rounded-2xl border border-gray-100 shadow-sm transition-all duration-300\" data-kid=\"1-3-2-2-2\" data-name=\"ai predictions stat card\">\n                    <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-3-2-2-2-1\" data-name=\"stat card header\">\n                        <div class=\"w-10 h-10 bg-cyan-50 rounded-xl flex items-center justify-center text-cyan-600 shrink-0\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"cpu icon container\">\n                            <i class=\"w-5 h-5\" data-kid=\"1-3-2-2-2-1-1-1\" data-lucide=\"cpu\" data-name=\"cpu icon\">\n                            </i>\n                        </div>\n                        <span class=\"text-[10px] font-semibold text-cyan-600 flex items-center gap-1 bg-cyan-50 px-1.5 py-0.5 rounded-md border border-cyan-100\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"ai predictions trend badge\">\n                            <i class=\"w-2.5 h-2.5\" data-kid=\"1-3-2-2-2-1-2-1\" data-lucide=\"trending-up\" data-name=\"trending up icon\">\n                            </i>\n                            +8%\n                            <span class=\"text-gray-400 font-normal hidden xl:inline\" data-kid=\"1-3-2-2-2-1-2-2\" data-name=\"ai predictions accuracy label\">\n                                94.6% accuracy\n                            </span>\n                        </span>\n                    </div>\n               